// The first check-sat is used while loading Cryptol; hang on the next one,
// which is issued while checking issue_2117.
:set tcTimeout=1
:set tcSolver=sh issue_2117_solver.sh 1
:load issue_2117.cry

// Confirm that the killed solver is replaced.
:set tcSolver=z3 -smt2 -in
:set tcTimeout=0
let x = 42 : [8]
x

// Also exercise the defaultReplExpr call outside of InferM.
:set tcTimeout=1
:set tcSolver=sh issue_2117_solver.sh 0
1

// Confirm recovery from that timeout as well.
:set tcSolver=z3 -smt2 -in
:set tcTimeout=0
x
